    /**
     * ============================================================================
     * 6. GÉOMÉTRIE SPATIALE & RECHERCHE GÉOGRAPHIQUE
     * ============================================================================
     */
    function pointInRing(lon, lat, ring) {
      let inside = false;
      for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
        const xi = ring[i][0], yi = ring[i][1];
        const xj = ring[j][0], yj = ring[j][1];
        const intersect = ((yi > lat) !== (yj > lat)) &&
          (lon < ((xj - xi) * (lat - yi)) / ((yj - yi) || 1e-12) + xi);
        if (intersect) inside = !inside;
      }
      return inside;
    }

    function pointInPolygonGeometry(lon, lat, geometry) {
      if (!geometry) return false;
      if (geometry.type === 'Polygon') {
        const rings = geometry.coordinates;
        if (!rings || !rings.length) return false;
        if (!pointInRing(lon, lat, rings[0])) return false;
        for (let h = 1; h < rings.length; h++) {
          if (pointInRing(lon, lat, rings[h])) return false;
        }
        return true;
      }
      if (geometry.type === 'MultiPolygon') {
        return geometry.coordinates.some(polyCoords => {
          if (!polyCoords || !polyCoords.length) return false;
          if (!pointInRing(lon, lat, polyCoords[0])) return false;
          for (let h = 1; h < polyCoords.length; h++) {
            if (pointInRing(lon, lat, polyCoords[h])) return false;
          }
          return true;
        });
      }
      return false;
    }

    function haversineMeters(lat1, lon1, lat2, lon2) {
      const R = 6371000;
      const toRad = d => (d * Math.PI) / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
      return 2 * R * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function minDistanceToGeometryMeters(lat, lon, geometry) {
      let minDist = Infinity;
      const scanRing = ring => {
        for (let i = 0; i < ring.length; i++) {
          const d = haversineMeters(lat, lon, ring[i][1], ring[i][0]);
          if (d < minDist) minDist = d;
        }
      };
      if (geometry.type === 'Polygon') geometry.coordinates.forEach(scanRing);
      else if (geometry.type === 'MultiPolygon') geometry.coordinates.forEach(poly => poly.forEach(scanRing));
      return minDist;
    }

    function analyzeCoordinates(lat, lon) {
      const matched = [];
      const nearby = [];

      for (const zoneType of ['ZFU', 'BER', 'ZRD']) {
        const layerData = appState.layers[zoneType].geojson;
        if (!layerData || !layerData.features) continue;

        for (const feature of layerData.features) {
          if (pointInPolygonGeometry(lon, lat, feature.geometry)) {
            matched.push({ zoneType, feature });
          } else {
            const distM = minDistanceToGeometryMeters(lat, lon, feature.geometry);
            if (distM <= 10000) nearby.push({ zoneType, feature, distanceMeters: distM });
          }
        }
      }
      nearby.sort((a, b) => a.distanceMeters - b.distanceMeters);
      return { matched, nearby: nearby.slice(0, 5) };
    }

    async function searchAddressBAN(query) {
      const url = `https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(query)}&limit=6`;
      const res = await fetch(url, { signal: AbortSignal.timeout(5000) });
      const data = await res.json();
      return (data.features || []).map(f => ({
        lat: f.geometry.coordinates[1],
        lon: f.geometry.coordinates[0],
        label: f.properties.label,
        context: f.properties.context
      }));
    }

    async function reverseGeocodeBAN(lat, lon) {
      try {
        const url = `https://api-adresse.data.gouv.fr/reverse/?lon=${lon}&lat=${lat}`;
        const res = await fetch(url, { signal: AbortSignal.timeout(4000) });
        const data = await res.json();
        if (data.features && data.features.length > 0) return { label: data.features[0].properties.label };
      } catch (_) {}
      return { label: `GPS (${lat.toFixed(5)}, ${lon.toFixed(5)})` };
    }

    async function handleLocationSelection(lat, lon, prefilledMeta = null, shouldZoom = true) {
      const spinner = document.getElementById('search-spinner');
      spinner.classList.remove('hidden');
      try {
        const meta = prefilledMeta || await reverseGeocodeBAN(lat, lon);
        appState.selectedPoint = { lat, lon, ...meta };

        if (appState.pinMarker) appState.map.removeLayer(appState.pinMarker);
        if (appState.radiusCircle) appState.map.removeLayer(appState.radiusCircle);

        const pinIcon = L.divIcon({
          className: '',
          html: `<div style="width:22px;height:22px;background:#ef4444;border:3px solid #fff;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.45);"></div>`,
          iconSize: [22, 22],
          iconAnchor: [11, 11]
        });

        appState.pinMarker = L.marker([lat, lon], { icon: pinIcon }).addTo(appState.map);
        appState.radiusCircle = L.circle([lat, lon], {
          radius: 1000,
          color: '#ef4444',
          weight: 1.2,
          dashArray: '5, 5',
          fillColor: '#ef4444',
          fillOpacity: 0.05,
          interactive: false
        }).addTo(appState.map);

        if (shouldZoom) appState.map.flyTo([lat, lon], 14, { duration: 0.8 });

        const { matched, nearby } = analyzeCoordinates(lat, lon);
        renderAnalysisPanel(appState.selectedPoint, matched, nearby);
        appState.pinMarker.bindPopup(buildLocationPopupHtml(appState.selectedPoint, matched), { maxWidth: 360 }).openPopup();
      } finally {
        spinner.classList.add('hidden');
      }
    }

    /**
     * ============================================================================
     * 7. INTERFACE ET MODALES DE RESTITUTION
     * ============================================================================
     */
    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderAnalysisPanel(point, matched, nearby) {
      const container = document.getElementById('analysis-container');
      container.classList.remove('hidden');
      document.getElementById('selected-address-title').textContent = point.label;
      document.getElementById('selected-coords-subtitle').textContent = `GPS : ${point.lat.toFixed(6)}, ${point.lon.toFixed(6)}`;

      const verdictEl = document.getElementById('eligibility-verdict');
      const matchedListEl = document.getElementById('matched-zones-list');
      const nearbyBoxEl = document.getElementById('nearby-zones-box');
      const nearbyListEl = document.getElementById('nearby-zones-list');

      matchedListEl.innerHTML = '';
      nearbyListEl.innerHTML = '';

      if (matched.length > 0) {
        verdictEl.className = 'rounded-xl p-3 border text-sm bg-emerald-500/10 border-emerald-500/40';
        verdictEl.innerHTML = `
          <div class="font-bold text-emerald-700 dark:text-emerald-300">✅ Périmètre géographique éligible détecté</div>
          <p class="text-xs mt-1 leading-relaxed">L’emplacement se situe dans <strong>${matched.length}</strong> périmètre(s) d’exonération.</p>
        `;

        matched.forEach(({ zoneType, feature }) => {
          const doc = REGIME_DOCS[zoneType];
          const props = feature.properties;
          const card = document.createElement('div');
          card.className = 'subtle-surface border rounded-xl p-3 text-xs space-y-2';
          card.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="px-2 py-0.5 rounded text-[11px] font-bold text-white ${doc.badgeBg}">${doc.code}</span>
              <button type="button" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">Fiche complète →</button>
            </div>
            <div class="font-bold text-sm">${escapeHtml(props._zoneName)}</div>
            <div class="muted-text">Fiscal : ${escapeHtml(doc.fiscal.summary)}</div>
          `;
          card.querySelector('button').addEventListener('click', () => openRegimeModal(zoneType, props));
          matchedListEl.appendChild(card);
        });
      } else {
        verdictEl.className = 'rounded-xl p-3 border text-sm bg-slate-500/10 border-slate-400/40';
        verdictEl.innerHTML = `
          <div class="font-bold">ℹ️ Hors périmètre direct</div>
          <p class="text-xs muted-text mt-1">Aucune zone active ne couvre directement ces coordonnées parmi les référentiels chargés.</p>
        `;
      }

      if (nearby.length > 0) {
        nearbyBoxEl.classList.remove('hidden');
        nearby.forEach(({ zoneType, feature, distanceMeters }) => {
          const doc = REGIME_DOCS[zoneType];
          const row = document.createElement('div');
          row.className = 'subtle-surface border rounded-lg px-2.5 py-1.5 flex items-center justify-between gap-2 text-xs';
          row.innerHTML = `
            <div class="truncate"><strong style="color:${doc.color}">${doc.code}</strong> · ${escapeHtml(feature.properties._zoneName)}</div>
            <span class="font-mono text-[11px] muted-text">~${Math.round(distanceMeters)} m</span>
          `;
          nearbyListEl.appendChild(row);
        });
      } else {
        nearbyBoxEl.classList.add('hidden');
      }
    }

    function buildZonePopupHtml(feature) {
      const props = feature.properties;
      const doc = REGIME_DOCS[props._zoneType];
      return `
        <div class="p-3.5 text-xs space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="px-2 py-0.5 rounded font-bold text-white ${doc.badgeBg}">${doc.code}</span>
            <span class="text-[11px] muted-text">${escapeHtml(props._source)}</span>
          </div>
          <h4 class="font-bold text-sm leading-snug">${escapeHtml(props._zoneName)}</h4>
          <p class="muted-text">${escapeHtml(doc.fiscal.summary)}</p>
          <button type="button" onclick="window.__openRegimeModal('${props._zoneType}', '${encodeURIComponent(JSON.stringify(props))}')" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition w-full">
            Fiche réglementaire complète
          </button>
        </div>
      `;
    }

    function buildLocationPopupHtml(point, matched) {
      if (!matched.length) return `<div class="p-3 text-xs"><b>${escapeHtml(point.label)}</b><br>Hors périmètre répertorié.</div>`;
      return `<div class="p-3 text-xs space-y-1"><b>${escapeHtml(point.label)}</b><br><span class="text-emerald-600 font-semibold">✓ ${matched.length} dispositif(s) applicable(s)</span></div>`;
    }

    window.__openRegimeModal = function(zoneType, encoded) {
      try {
        openRegimeModal(zoneType, JSON.parse(decodeURIComponent(encoded)));
      } catch (_) {
        openRegimeModal(zoneType, {});
      }
    };

    function openRegimeModal(zoneType, props = {}) {
      const doc = REGIME_DOCS[zoneType];
      const modal = document.getElementById('detail-modal');
      document.getElementById('modal-badge').className = `px-2.5 py-1 rounded-lg text-xs font-bold text-white shrink-0 ${doc.badgeBg}`;
      document.getElementById('modal-badge').textContent = doc.code;
      document.getElementById('modal-title').textContent = props._zoneName || doc.fullName;

      document.getElementById('modal-body').innerHTML = `
        <div class="subtle-surface border rounded-xl p-3.5 space-y-2 text-xs">
          <h4 class="font-bold uppercase tracking-wider muted-text">1. Cadre géographique & Validité</h4>
          <div><strong>Dispositif :</strong> ${escapeHtml(doc.fullName)}</div>
          <div><strong>Périmètre :</strong> ${escapeHtml(doc.perimeterType)}</div>
          <div><strong>Validité légale :</strong> <span class="text-amber-600 dark:text-amber-400 font-medium">${escapeHtml(doc.validity)}</span></div>
        </div>
        <div class="border border-blue-500/30 bg-blue-500/5 rounded-xl p-3.5 space-y-2 text-xs">
          <h4 class="font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">2. Exonérations Fiscales</h4>
          <p>${escapeHtml(doc.fiscal.summary)}</p>
          <p><strong>Plafonds :</strong> ${escapeHtml(doc.fiscal.ceiling)}</p>
        </div>
        <div class="border border-emerald-500/30 bg-emerald-500/5 rounded-xl p-3.5 space-y-2 text-xs">
          <h4 class="font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">3. Exonérations Sociales (URSSAF)</h4>
          <p>${escapeHtml(doc.social.summary)}</p>
        </div>
        <div class="subtle-surface border rounded-xl p-3.5 space-y-2 text-xs">
          <h4 class="font-bold uppercase tracking-wider muted-text">4. Conditions d’éligibilité juridique</h4>
          <ul class="list-disc pl-4 space-y-1">${doc.conditions.map(c => `<li>${escapeHtml(c)}</li>`).join('')}</ul>
        </div>
        <div class="space-y-1 text-xs">
          <h4 class="font-bold uppercase tracking-wider muted-text">5. Sources officielles</h4>
          ${doc.references.map(r => `<div><a href="${r.url}" target="_blank" class="text-blue-600 hover:underline">↗ ${escapeHtml(r.label)}</a></div>`).join('')}
        </div>
      `;
      modal.classList.remove('hidden');
    }

    /**
     * ============================================================================
     * 8. ÉCOUTEURS D'ÉVÉNEMENTS & DÉMARRAGE INDÉPENDANT
     * ============================================================================
     */
    function bindEvents() {
      document.getElementById('btn-theme').addEventListener('click', () => {
        const root = document.documentElement;
        root.setAttribute('data-theme', root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });

      document.getElementById('btn-close-modal').addEventListener('click', () => document.getElementById('detail-modal').classList.add('hidden'));
      document.getElementById('btn-close-modal-footer').addEventListener('click', () => document.getElementById('detail-modal').classList.add('hidden'));

      // Rechargement individuel par couche
      document.querySelectorAll('.btn-reload-layer').forEach(btn => {
        btn.addEventListener('click', async () => {
          const zType = btn.dataset.layer;
          btn.textContent = 'Chargement…';
          await loadLayerIndependent(zType);
          btn.textContent = '↻ Recharger';
        });
      });

      // Import GeoJSON manuel par couche
      document.querySelectorAll('.file-layer-input').forEach(input => {
        input.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          const zType = input.dataset.layer;
          if (!file) return;
          try {
            const text = await file.text();
            const json = JSON.parse(text);
            const normalized = normalizeGeoJson(json, zType, `Fichier local (${file.name})`);
            if (normalized.features.length > 0) {
              appState.layers[zType].geojson = normalized;
              appState.layers[zType].loaded = true;
              appState.layers[zType].count = normalized.features.length;
              appState.layers[zType].source = file.name;
              renderLayerOnMap(zType);
              updateDiagnosticPanel(zType);
            }
          } catch (err) {
            alert('Erreur d’import GeoJSON : ' + err.message);
          }
          input.value = '';
        });
      });

      // Filtres
      ['ZFU', 'BER', 'ZRD'].forEach(zType => {
        const chk = document.getElementById(`filter-${zType.toLowerCase()}`);
        chk.addEventListener('change', () => {
          appState.layers[zType].visible = chk.checked;
          const l = appState.layers[zType].leafletLayer;
          if (l) {
            if (chk.checked) l.addTo(appState.map);
            else appState.map.removeLayer(l);
          }
        });
      });

      document.getElementById('btn-toggle-all-layers').addEventListener('click', () => {
        const next = !['ZFU', 'BER', 'ZRD'].every(z => appState.layers[z].visible);
        ['ZFU', 'BER', 'ZRD'].forEach(z => {
          document.getElementById(`filter-${z.toLowerCase()}`).checked = next;
          appState.layers[z].visible = next;
          const l = appState.layers[z].leafletLayer;
          if (l) {
            if (next) l.addTo(appState.map);
            else appState.map.removeLayer(l);
          }
        });
      });

      // Opacité
      document.getElementById('opacity-slider').addEventListener('input', (e) => {
        appState.fillOpacity = parseInt(e.target.value, 10) / 100;
        document.getElementById('opacity-value').textContent = `${e.target.value}%`;
        ['ZFU', 'BER', 'ZRD'].forEach(z => {
          if (appState.layers[z].leafletLayer) appState.layers[z].leafletLayer.setStyle({ fillOpacity: appState.fillOpacity });
        });
      });

      // Navigation DROM / Métropole
      document.querySelectorAll('[data-fly]').forEach(btn => {
        btn.addEventListener('click', () => {
          const [lat, lon, zoom] = btn.dataset.fly.split(',').map(Number);
          appState.map.flyTo([lat, lon], zoom, { duration: 0.8 });
        });
      });

      document.getElementById('basemap-select').addEventListener('change', e => setBasemap(e.target.value));

      // Recherche
      const searchInput = document.getElementById('search-input');
      const suggestionsList = document.getElementById('search-suggestions');
      searchInput.addEventListener('input', async () => {
        const val = searchInput.value.trim();
        if (val.length < 3) {
          suggestionsList.classList.add('hidden');
          return;
        }
        try {
          const results = await searchAddressBAN(val);
          suggestionsList.innerHTML = results.map(item => `
            <li class="px-3 py-2 text-xs cursor-pointer hover:bg-blue-600/10">
              <div class="font-semibold">${escapeHtml(item.label)}</div>
              <div class="text-[11px] muted-text">${escapeHtml(item.context || '')}</div>
            </li>
          `).join('');
          suggestionsList.querySelectorAll('li').forEach((li, idx) => {
            li.addEventListener('click', () => {
              searchInput.value = results[idx].label;
              suggestionsList.classList.add('hidden');
              handleLocationSelection(results[idx].lat, results[idx].lon, results[idx], true);
            });
          });
          suggestionsList.classList.remove('hidden');
        } catch (_) {}
      });

      document.getElementById('btn-search-submit').addEventListener('click', async () => {
        const results = await searchAddressBAN(searchInput.value.trim());
        if (results.length > 0) handleLocationSelection(results[0].lat, results[0].lon, results[0], true);
      });
    }

    window.addEventListener('DOMContentLoaded', async () => {
      initMap();
      bindEvents();

      // Chargement 100% indépendant et asynchrone des trois couches
      await Promise.all([
        loadLayerIndependent('ZFU'),
        loadLayerIndependent('BER'),
        loadLayerIndependent('ZRD')
      ]);
    });
  </script>
</body>
</html>
