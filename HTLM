      if (geojson && geojson.features.length > 0) {
        appState.layers[zoneType].geojson = geojson;
        appState.layers[zoneType].loaded = true;
        appState.layers[zoneType].count = geojson.features.length;
        appState.layers[zoneType].date = new Date().toLocaleDateString('fr-FR');
        appState.layers[zoneType].source = dataSource;

        try {
          localStorage.setItem(cacheKey, JSON.stringify(geojson));
