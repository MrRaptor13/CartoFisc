     * 5. CHARGEMENT INDÉPENDANT DES COUCHES AVEC CACHE LOCAL & REPLI GOUV.FR
     * ============================================================================
     */
    async function fetchWithProxyFallback(urls) {
      for (const targetUrl of urls) {
        for (const proxyBuilder of PROXY_URLS) {
          try {
            const finalUrl = proxyBuilder(targetUrl);
            const res = await fetch(finalUrl, { signal: AbortSignal.timeout(12000) });
            if (!res.ok) continue;
            const data = await res.json();
            if (data && (Array.isArray(data.features) || data.type === 'FeatureCollection')) {
              return { data, sourceUrl: targetUrl };
            }
          } catch (_) {}
        }
      }
      return null;
    }

    async function fetchCommunesGeoJson(inseeList, zoneType, labelPrefix) {
      const features = [];
      const batchSize = 20;
      for (let i = 0; i < inseeList.length; i += batchSize) {
        const batch = inseeList.slice(i, i + batchSize);
        await Promise.all(batch.map(async (code) => {
          try {
            const url = `https://geo.api.gouv.fr/communes/${code}?fields=nom,code,contour&format=geojson&geometry=contour`;
            const res = await fetch(url, { signal: AbortSignal.timeout(6000) });
            if (!res.ok) return;
            const feat = await res.json();
            if (feat && feat.geometry) {
              feat.properties = {
                ...feat.properties,
                _zoneType: zoneType,
                _zoneName: `${labelPrefix} — ${feat.properties.nom} (${feat.properties.code})`,
                _communes: `${feat.properties.nom} (${feat.properties.code})`,
                _source: 'geo.api.gouv.fr (IGN Admin Express)'
              };
              features.push(feat);
            }
          } catch (_) {}
        }));
      }
      return { type: 'FeatureCollection', features };
    }

    function normalizeGeoJson(data, zoneType, defaultSource) {
      if (!data || !Array.isArray(data.features)) return { type: 'FeatureCollection', features: [] };

      data.features = data.features
        .filter(f => f && f.geometry && (f.geometry.type === 'Polygon' || f.geometry.type === 'MultiPolygon'))
        .map(f => {
          const p = f.properties || {};
          const name = p.nom_zfu || p.lib_zfu || p.nom_quartier || p.nom_zone || p.libelle || p.nom || p.name || p.lib_com || `${zoneType} Officiel`;
          const communes = p.communes || p.liste_communes || p.nom_com || p.lib_com || p.nom || 'Périmètre officiel';
          f.properties = {
            ...p,
            _zoneType: zoneType,
            _zoneName: name,
            _communes: communes,
            _source: defaultSource
          };
          return f;
        });

      return data;
    }

    async function loadLayerIndependent(zoneType) {
      const cacheKey = `cartofisc_layer_${zoneType}`;
      let geojson = null;
      let dataSource = '';

      // 1. Essai cache localStorage
      try {
        const cached = localStorage.getItem(cacheKey);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (parsed && Array.isArray(parsed.features) && parsed.features.length > 0) {
            geojson = parsed;
            dataSource = 'Cache local navigateur';
          }
        }
      } catch (_) {}

      // 2. Si pas de cache, essai des flux distants via proxy
      if (!geojson || geojson.features.length === 0) {
        const remote = await fetchWithProxyFallback(REMOTE_ENDPOINTS[zoneType] || []);
        if (remote) {
          geojson = normalizeGeoJson(remote.data, zoneType, remote.sourceUrl);
          dataSource = 'API Publique / Proxy distant';
        }
      }

      // 3. Repli géométrique officiel par communes administratives si distant échoue
      if ((!geojson || geojson.features.length === 0) && zoneType === 'BER') {
        geojson = await fetchCommunesGeoJson(FALLBACK_BER_CODES, 'BER', 'Bassin d’Emploi à Redynamiser');
        dataSource = 'geo.api.gouv.fr (BER officiel)';
      } else if ((!geojson || geojson.features.length === 0) && zoneType === 'ZRD') {
        geojson = await fetchCommunesGeoJson(FALLBACK_ZRD_CODES, 'ZRD', 'Zone de Restructuration de la Défense');
        dataSource = 'geo.api.gouv.fr (ZRD officiel)';
      } else if ((!geojson || geojson.features.length === 0) && zoneType === 'ZFU') {
        geojson = normalizeGeoJson(FALLBACK_ZFU_GEOJSON, 'ZFU', 'Référentiel historique ZFU-TE');
        dataSource = 'Référentiel de secours ZFU';
