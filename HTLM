          { label: 'Article 44 octies A du CGI (Légifrance)', url: 'https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000048844610' },
          { label: 'data.gouv.fr — Dataset officiel ZFU', url: 'https://www.data.gouv.fr/datasets/zones-franches-urbaines-zfu' }
        ]
      },
      BER: {
        code: 'BER',
        fullName: 'Bassin d’Emploi à Redynamiser',
        color: '#059669',
        badgeBg: 'bg-emerald-600',
        validity: 'Jusqu’au 31 décembre 2026 (Champagne-Ardenne : vallée de la Meuse ; Midi-Pyrénées : vallée de l’Ariège).',
        perimeterType: 'Périmètre communal intégral (Décret n° 2007-228 modifié)',
        fiscal: {
          summary: 'Exonération totale d’impôt sur les bénéfices (IR/IS) pendant 5 ans. Exonération de CFE et de TFPB pendant 5 ans.',
          ceiling: 'Soumis au règlement européen de minimis (300 000 € sur 3 exercices glissants).'
        },
        social: {
          summary: 'Exonération pendant 5 ans des cotisations patronales d’assurances sociales et allocations familiales dans la limite de 1,4 SMIC.'
        },
        conditions: [
          'Création ou implantation d’activité dans les communes classées en BER.',
          'Exclusion des activités de crédit, finance, assurance, location d’immeubles et agriculture.'
        ],
        references: [
          { label: 'Article 44 duodecies du CGI (Légifrance)', url: 'https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000048844625' }
        ]
      },
      ZRD: {
        code: 'ZRD',
        fullName: 'Zone de Restructuration de la Défense',
        color: '#d97706',
        badgeBg: 'bg-amber-600',
        validity: 'Période de 6 ans à compter de la publication de l’arrêté de reconnaissance du site militaire restructuré.',
        perimeterType: 'Périmètre communal ou intercommunal (Décret n° 2009-38 et arrêtés d’application)',
        fiscal: {
          summary: 'Exonération d’impôt sur les bénéfices (IR/IS) pendant 5 ans, puis abattement dégressif sur 2 ans (2/3 et 1/3).',
          ceiling: 'Plafond global des aides de minimis.'
        },
        social: {
          summary: 'Exonération de cotisations patronales pendant 5 ans pour les activités nouvelles créées.'
        },
        conditions: [
          'Création d’une activité nouvelle ne résultant pas d’un transfert ou d’une reprise d’activité préexistante dans la zone.'
        ],
        references: [
          { label: 'Article 44 terdecies du CGI & Décret n° 2009-38 (Légifrance)', url: 'https://www.legifrance.gouv.fr/loda/id/JORFTEXT000021042550' }
