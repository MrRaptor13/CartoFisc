<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>CartoFisc France — Zones d’Exonérations Fiscales (ZFU-TE, BER, ZRD)</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🗺️</text></svg>">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <style>
    :root {
      --bg-app: #f8fafc;
      --bg-panel: #ffffff;
      --bg-subtle: #f1f5f9;
      --text-main: #0f172a;
      --text-muted: #475569;
      --border-color: #cbd5e1;
      --accent: #1d4ed8;
      --zfu-color: #2563eb;
      --ber-color: #059669;
      --zrd-color: #d97706;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg-app: #020617;
        --bg-panel: #0f172a;
        --bg-subtle: #1e293b;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border-color: #334155;
        --accent: #3b82f6;
      }
    }

    :root[data-theme="dark"] {
      --bg-app: #020617;
      --bg-panel: #0f172a;
      --bg-subtle: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
      --accent: #3b82f6;
    }

    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      color: var(--text-main);
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .panel-surface {
      background-color: var(--bg-panel);
      border-color: var(--border-color);
      color: var(--text-main);
    }

    .subtle-surface {
      background-color: var(--bg-subtle);
      border-color: var(--border-color);
    }

    .muted-text {
      color: var(--text-muted);
    }

    #map {
      width: 100%;
      height: 100%;
      z-index: 1;
      background: #e2e8f0;
    }

    .leaflet-popup-content-wrapper {
      background-color: var(--bg-panel);
      color: var(--text-main);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25);
      padding: 0;
    }

    .leaflet-popup-tip {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-color);
    }

    .leaflet-popup-content {
      margin: 0;
      width: 350px !important;
      max-width: 85vw !important;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(100, 116, 139, 0.35);
      border-radius: 999px;
    }
  </style>
</head>
<body class="flex flex-col overflow-hidden">

  <!-- En-tête -->
  <header class="panel-surface border-b px-4 py-2.5 flex items-center justify-between gap-3 shrink-0 z-30 shadow-sm">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shrink-0 shadow-sm">
        §
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-base sm:text-lg font-bold tracking-tight truncate">CartoFisc France</h1>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-blue-600/15 text-blue-600 dark:text-blue-400">
            ZFU-TE (Historique) · BER · ZRD
          </span>
        </div>
        <p class="text-xs muted-text truncate hidden sm:block">
          Vérification des périmètres géographiques d’exonérations fiscales et sociales pour cabinets comptables
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button type="button" id="btn-methodology" class="subtle-surface border rounded-lg px-2.5 py-1.5 text-xs font-medium hover:opacity-85 transition">
        Cadre légal &amp; Sources
      </button>
      <button type="button" id="btn-theme" class="subtle-surface border rounded-lg p-1.5 text-xs font-medium hover:opacity-85 transition" title="Changer le thème" aria-label="Changer le thème">
        🌓
      </button>
    </div>
  </header>

  <!-- Corps principal -->
  <div class="flex-1 flex flex-col lg:flex-row min-h-0 relative overflow-hidden">

    <!-- Panneau latéral -->
    <aside id="sidebar" class="panel-surface w-full lg:w-[420px] xl:w-[450px] border-b lg:border-b-0 lg:border-r flex flex-col max-h-[52vh] lg:max-h-none shrink-0 z-20 overflow-y-auto">

      <!-- 1. Moteur de recherche géographique -->
      <div class="p-4 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between mb-2">
          <label for="search-input" class="text-xs font-bold uppercase tracking-wider muted-text">
            1. Localiser un établissement
          </label>
          <button type="button" id="btn-geolocate" class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
            <span>📍 Ma position</span>
          </button>
        </div>

        <div class="relative">
          <div class="flex gap-1.5">
            <div class="relative flex-1">
              <input
                type="text"
                id="search-input"
                autocomplete="off"
                placeholder="Adresse, commune ou GPS (ex: 48.856, 2.352)"
                class="w-full subtle-surface border rounded-xl pl-3 pr-8 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
              <button type="button" id="btn-clear-search" class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-xs muted-text hover:text-red-500 p-1" title="Effacer">
                ✕
              </button>
            </div>
            <button type="button" id="btn-search-submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl px-3.5 py-2 text-sm transition shrink-0">
              Vérifier
            </button>
          </div>
          <ul id="search-suggestions" class="hidden absolute left-0 right-0 mt-1.5 panel-surface border rounded-xl shadow-xl max-h-60 overflow-y-auto z-50 divide-y divide-slate-200 dark:divide-slate-800"></ul>
        </div>
        <p class="text-[11px] muted-text mt-2 flex items-center justify-between gap-2">
          <span>Cliquez directement sur la carte pour tester une parcelle.</span>
          <span id="search-spinner" class="hidden text-blue-600 font-medium">Recherche…</span>
        </p>
      </div>

      <!-- 2. Résultat d'analyse -->
      <div id="analysis-container" class="p-4 border-b border-slate-200 dark:border-slate-800 hidden">
        <div class="flex items-start justify-between gap-2 mb-2.5">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider muted-text block">
              Diagnostic d’implantation
            </span>
            <h2 id="selected-address-title" class="text-sm font-bold leading-snug mt-0.5"></h2>
            <p id="selected-coords-subtitle" class="text-xs muted-text font-mono mt-0.5"></p>
          </div>
          <button type="button" id="btn-center-pin" class="subtle-surface border rounded-lg px-2 py-1 text-xs font-medium shrink-0" title="Recentrer">
            🎯 Centrer
          </button>
        </div>
        <div id="eligibility-verdict" class="rounded-xl p-3 border text-sm"></div>
        <div id="matched-zones-list" class="mt-3 space-y-2.5"></div>
        <div id="nearby-zones-box" class="mt-3 hidden">
          <div class="text-xs font-semibold muted-text mb-1.5">Périmètres à proximité (&lt; 10 km) :</div>
          <div id="nearby-zones-list" class="space-y-1.5"></div>
        </div>
        <div class="mt-3 p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/30 text-[11px] leading-relaxed">
          <strong class="text-amber-700 dark:text-amber-400">Attention (Règle des 5 ans / Droits acquis) :</strong>
          L’appartenance géographique est une condition nécessaire. En ZFU-TE (extinction au 01/01/2026 pour les nouvelles implantations), seuls les droits en cours de période d’exonération (5 ans + 3 ans dégressifs) demeurent applicables sous réserve des conditions d’emploi local.
        </div>
      </div>

      <!-- 3. Filtres & Diagnostic indépendant par couche -->
      <div class="p-4 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-xs font-bold uppercase tracking-wider muted-text">
            2. Dispositifs &amp; Diagnostic de chargement
          </span>
          <button type="button" id="btn-toggle-all-layers" class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium">
            Tout afficher
          </button>
        </div>

        <div class="space-y-3" id="layers-list">
          <!-- ZFU-TE -->
          <div class="subtle-surface border rounded-xl p-3 transition">
            <div class="flex items-start justify-between gap-2">
              <label class="flex items-start gap-2.5 cursor-pointer select-none flex-1">
                <input type="checkbox" id="filter-zfu" checked class="mt-1 w-4 h-4 rounded accent-blue-600 cursor-pointer">
                <div>
                  <span class="font-bold text-sm flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm inline-block shrink-0" style="background:#2563eb;"></span>
                    ZFU-TE (Dispositif Historique)
                  </span>
                  <p class="text-xs muted-text mt-0.5" id="diag-zfu-desc">Chargement des quartiers prioritaires ANCT…</p>
                </div>
              </label>
            </div>
            <div class="mt-2.5 pt-2 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2 text-xs">
              <span id="diag-zfu-meta" class="muted-text font-mono text-[11px]">Statut : Initialisation</span>
              <button type="button" class="btn-reload-layer text-blue-600 dark:text-blue-400 hover:underline font-semibold" data-layer="ZFU">↻ Recharger</button>
              <label class="cursor-pointer text-blue-600 dark:text-blue-400 hover:underline font-semibold">
                <span>📁 MAJ GeoJSON</span>
                <input type="file" class="hidden file-layer-input" accept=".json,.geojson" data-layer="ZFU">
              </label>
            </div>
          </div>

          <!-- BER -->
          <div class="subtle-surface border rounded-xl p-3 transition">
            <div class="flex items-start justify-between gap-2">
              <label class="flex items-start gap-2.5 cursor-pointer select-none flex-1">
                <input type="checkbox" id="filter-ber" checked class="mt-1 w-4 h-4 rounded accent-emerald-600 cursor-pointer">
                <div>
                  <span class="font-bold text-sm flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm inline-block shrink-0" style="background:#059669;"></span>
                    BER (Bassins d’Emploi)
                  </span>
                  <p class="text-xs muted-text mt-0.5" id="diag-ber-desc">Chargement des communes classées…</p>
                </div>
              </label>
            </div>
            <div class="mt-2.5 pt-2 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2 text-xs">
              <span id="diag-ber-meta" class="muted-text font-mono text-[11px]">Statut : Initialisation</span>
              <button type="button" class="btn-reload-layer text-emerald-600 dark:text-emerald-400 hover:underline font-semibold" data-layer="BER">↻ Recharger</button>
              <label class="cursor-pointer text-emerald-600 dark:text-emerald-400 hover:underline font-semibold">
                <span>📁 MAJ GeoJSON</span>
                <input type="file" class="hidden file-layer-input" accept=".json,.geojson" data-layer="BER">
              </label>
            </div>
          </div>

          <!-- ZRD -->
          <div class="subtle-surface border rounded-xl p-3 transition">
            <div class="flex items-start justify-between gap-2">
              <label class="flex items-start gap-2.5 cursor-pointer select-none flex-1">
                <input type="checkbox" id="filter-zrd" checked class="mt-1 w-4 h-4 rounded accent-amber-600 cursor-pointer">
                <div>
                  <span class="font-bold text-sm flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm inline-block shrink-0" style="background:#d97706;"></span>
                    ZRD (Restructuration Défense)
                  </span>
                  <p class="text-xs muted-text mt-0.5" id="diag-zrd-desc">Chargement des emprises et communes ZRD…</p>
                </div>
              </label>
            </div>
            <div class="mt-2.5 pt-2 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2 text-xs">
              <span id="diag-zrd-meta" class="muted-text font-mono text-[11px]">Statut : Initialisation</span>
              <button type="button" class="btn-reload-layer text-amber-600 dark:text-amber-400 hover:underline font-semibold" data-layer="ZRD">↻ Recharger</button>
              <label class="cursor-pointer text-amber-600 dark:text-amber-400 hover:underline font-semibold">
                <span>📁 MAJ GeoJSON</span>
                <input type="file" class="hidden file-layer-input" accept=".json,.geojson" data-layer="ZRD">
              </label>
            </div>
          </div>
        </div>

        <!-- Opacité -->
        <div class="mt-3 pt-2.5 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3">
          <label for="opacity-slider" class="text-xs muted-text shrink-0">Opacité des zones</label>
          <input type="range" id="opacity-slider" min="10" max="75" value="32" class="w-32 accent-blue-600 cursor-pointer">
          <span id="opacity-value" class="text-xs font-mono w-9 text-right">32%</span>
        </div>
      </div>

      <!-- Sources & Hors ligne -->
      <div class="p-4 text-xs muted-text space-y-2 mt-auto">
        <div class="flex items-center justify-between">
          <span class="font-semibold">Mode de résilience :</span>
          <span class="font-mono text-emerald-600 dark:text-emerald-400">Proxy distant + Cache local</span>
        </div>
        <p class="text-[11px] leading-relaxed">
          Données validées EPSG:4326. En cas d’absence de connexion ou de blocage réseau, l’application bascule automatiquement sur son cache de secours embarqué.
        </p>
      </div>
    </aside>

    <!-- Carte interactive -->
    <main class="flex-1 relative min-h-[48vh]">
      <div id="map"></div>

      <div class="absolute top-3 right-3 z-[400] flex flex-wrap gap-1.5 justify-end max-w-[calc(100%-60px)]">
        <div class="panel-surface border rounded-xl shadow-md p-1 flex items-center gap-1 text-xs">
          <button type="button" data-fly="46.6,2.4,6" class="px-2 py-1 rounded-lg hover:bg-blue-600/10 font-medium">Métropole</button>
          <button type="button" data-fly="16.25,-61.55,10" class="px-2 py-1 rounded-lg hover:bg-blue-600/10">Guadeloupe</button>
          <button type="button" data-fly="14.64,-61.02,10" class="px-2 py-1 rounded-lg hover:bg-blue-600/10">Martinique</button>
          <button type="button" data-fly="4.92,-52.32,10" class="px-2 py-1 rounded-lg hover:bg-blue-600/10">Guyane</button>
          <button type="button" data-fly="-21.12,55.53,10" class="px-2 py-1 rounded-lg hover:bg-blue-600/10">La Réunion</button>
        </div>
        <select id="basemap-select" aria-label="Fond de carte" class="panel-surface border rounded-xl shadow-md px-2.5 py-1.5 text-xs font-medium cursor-pointer">
          <option value="plan">Plan IGN v2 (Officiel)</option>
          <option value="light">Fond clair épuré</option>
          <option value="satellite">Photo aérienne (IGN)</option>
        </select>
      </div>

      <div class="absolute bottom-5 left-3 z-[400] panel-surface border rounded-xl shadow-md px-3 py-2 text-xs max-w-[280px] hidden sm:block">
        <div class="font-bold mb-1.5 text-[11px] uppercase tracking-wider muted-text">Légende officielle</div>
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded border border-blue-800 shrink-0" style="background:rgba(37,99,235,0.45)"></span>
            <span><strong>ZFU-TE</strong> : Quartiers historiques (extinct 2026)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded border border-emerald-800 shrink-0" style="background:rgba(5,150,105,0.45)"></span>
            <span><strong>BER</strong> : Communes bassins d’emploi</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded border border-amber-800 shrink-0" style="background:rgba(217,119,6,0.45)"></span>
            <span><strong>ZRD</strong> : Communes restructuration défense</span>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Modale -->
  <div id="detail-modal" class="hidden fixed inset-0 z-[1000] bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="panel-surface border rounded-2xl shadow-2xl max-w-2xl w-full max-h-[88vh] flex flex-col overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <span id="modal-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold text-white shrink-0"></span>
          <h3 id="modal-title" class="text-base sm:text-lg font-bold truncate"></h3>
        </div>
        <button type="button" id="btn-close-modal" class="subtle-surface border rounded-lg px-2.5 py-1 text-sm font-bold hover:opacity-80">✕</button>
      </div>
      <div id="modal-body" class="p-5 overflow-y-auto space-y-4 text-sm leading-relaxed"></div>
      <div class="px-5 py-3 border-t border-slate-200 dark:border-slate-800 subtle-surface flex items-center justify-between gap-2 text-xs">
        <span class="muted-text">Référentiel fiscal &amp; social — Usage informatif</span>
        <button type="button" id="btn-close-modal-footer" class="bg-blue-600 text-white font-semibold px-4 py-1.5 rounded-lg">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    /**
     * ============================================================================
     * 1. RÉFÉRENTIEL FISCAL ET SOCIAL OFFICIEL (DISTINCTION HISTORIQUE / ACTIF)
     * ============================================================================
     */
    const REGIME_DOCS = {
